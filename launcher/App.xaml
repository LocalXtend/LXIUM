<Application x:Class="LXIUM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="Font">Segoe UI Variable Display, Segoe UI, Malgun Gothic</FontFamily>

        <SolidColorBrush x:Key="Bg" Color="#F5F4FA"/>
        <SolidColorBrush x:Key="Ink" Color="#1E1B2E"/>
        <SolidColorBrush x:Key="Sub" Color="#5E5A72"/>
        <SolidColorBrush x:Key="Teal" Color="#2F5F6E"/>
        <SolidColorBrush x:Key="TealHover" Color="#244C59"/>

        <!-- 카드 배경: 분홍·초록·파랑·보라·민트 파스텔 그라디언트 -->
        <LinearGradientBrush x:Key="Pink" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDEAF4" Offset="0"/><GradientStop Color="#F6CBE1" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Green" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F1FAE4" Offset="0"/><GradientStop Color="#D0EFB9" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Blue" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EAF4FE" Offset="0"/><GradientStop Color="#C9E1F8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Purple" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E6E0FE" Offset="0"/><GradientStop Color="#C2B5F6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Mint" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E6F8EB" Offset="0"/><GradientStop Color="#BFEACB" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="Shadow" BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.10" Color="#4B3F7A"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="26"/>
        </Style>
        <Style x:Key="Inner" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect" Value="{StaticResource Shadow}"/>
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect" Value="{StaticResource Shadow}"/>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Teal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TealHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2DFEC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0EEF7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 템플릿 없이 내용만 그리는 클릭 영역 (게임 카드) -->
        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value><TranslateTransform Y="-4"/></Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 로더 선택: 흰 알약, 선택되면 청록 -->
        <Style x:Key="PillItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Style="{StaticResource Pill}" Padding="14,8">
                            <TextBlock x:Name="T" Text="{Binding Label}" Style="{StaticResource PillText}" FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource Teal}"/>
                                <Setter TargetName="T" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="TextPill">
            <Border Style="{StaticResource Pill}">
                <TextBlock Text="{Binding}" Style="{StaticResource PillText}"/>
            </Border>
        </DataTemplate>
    </Application.Resources>
</Application>
