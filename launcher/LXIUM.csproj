<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LXIUM</AssemblyName>
    <RootNamespace>LXIUM</RootNamespace>
    <Product>LXIUM</Product>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../ver.txt').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <!-- 언어 파일: exe 옆 lang/ 폴더에 둠 (사용자가 언어를 더할 수 있게 단일 exe에 넣지 않음) -->
  <ItemGroup>
    <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
