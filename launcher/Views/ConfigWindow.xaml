<Window x:Class="LXIUM.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="760" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Font}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="Heading" Style="{StaticResource Title}" FontSize="24"/>
            <TextBlock x:Name="FilePath" Style="{StaticResource Desc}" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock Text="바꾼 설정은 게임을 다시 시작하면 적용됩니다. 게임이 실행 중이면 끈 뒤 저장하세요."
                       Style="{StaticResource Desc}" FontSize="13" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,14" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Background="{StaticResource Mint}" Padding="22" Margin="0,0,6,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Title}" FontSize="18" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                                                <DockPanel>
                                                    <!-- 값 편집: 참/거짓 = 체크, 선택지 = 목록, 그 밖 = 글 -->
                                                    <Grid DockPanel.Dock="Right" Width="200" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <CheckBox IsChecked="{Binding BoolValue}" Content="켬" HorizontalAlignment="Right"
                                                                  Visibility="{Binding IsBool, Converter={StaticResource Vis}}"/>
                                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"
                                                                  Visibility="{Binding HasChoices, Converter={StaticResource Vis}}"/>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                                                                 Visibility="{Binding IsText, Converter={StaticResource Vis}}"/>
                                                    </Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Key}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Desc}" FontSize="13" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Desc}" FontSize="11" Margin="0,3,0,0" Opacity="0.8"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Ghost}" Content="취소" IsCancel="True" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Primary}" Content="저장" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
