<Window x:Class="LXIUM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LXIUM" Width="1180" Height="800" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Font}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>

    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 머리글 -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateButton" Style="{StaticResource Primary}" Tag="{StaticResource IconDownload}"
                        ContentTemplate="{StaticResource IconText}" Click="ApplyUpdate_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                <Button x:Name="BackButton" Style="{StaticResource Ghost}" Tag="{StaticResource IconBack}" Content="라이브러리"
                        ContentTemplate="{StaticResource IconText}" Click="Back_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconRefresh}"
                        ToolTip="새로 고침 (게임·애드온 모음 다시 확인)" Click="Refresh_Click" Margin="0,0,10,0"/>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconSettings}"
                        ToolTip="설정" Click="Settings_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="LXIUM" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="Subtitle" Text="게임 모드 런처" Style="{StaticResource Desc}"/>
            </StackPanel>
        </DockPanel>

        <!-- 라이브러리 -->
        <ScrollViewer x:Name="LibraryView" Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,0,24">
                <TextBlock x:Name="EmptyText" Style="{StaticResource Desc}" Visibility="Collapsed"/>
                <ItemsControl x:Name="GameList" AlternationCount="5" ItemsPanel="{StaticResource Wrap}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Plain}" Click="Game_Click" Margin="0,0,20,20">
                                <Border Width="236" Padding="14" Effect="{StaticResource Shadow}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Setter Property="Background" Value="{StaticResource Pink}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                                    <Setter Property="Background" Value="{StaticResource Green}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="2">
                                                    <Setter Property="Background" Value="{StaticResource Blue}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="3">
                                                    <Setter Property="Background" Value="{StaticResource Purple}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="4">
                                                    <Setter Property="Background" Value="{StaticResource Mint}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Width="208" Height="312">
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="0,0,208,312" RadiusX="16" RadiusY="16"/>
                                            </Grid.Clip>
                                            <Rectangle Fill="#AAFFFFFF"/>
                                            <Image Source="{Binding CapsuleUrl}" Stretch="UniformToFill"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Title}" FontSize="17" Margin="4,14,4,8"/>
                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="4,0,0,2">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource PillText}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 게임 상세: 벤토 격자 -->
        <ScrollViewer x:Name="DetailView" Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Grid Margin="0,4,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 게임 정보 (Steam 상점) -->
                <Border Style="{StaticResource Card}" Background="{StaticResource Pink}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Width="156" Height="208" CornerRadius="16" Background="White" Effect="{StaticResource Shadow}" VerticalAlignment="Top">
                            <Image x:Name="Cover" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,156,208" RadiusX="16" RadiusY="16"/>
                                </Image.Clip>
                            </Image>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="24,2,0,0">
                            <TextBlock Text="{Binding Game.Name}" Style="{StaticResource Title}" FontSize="26"/>
                            <TextBlock x:Name="InfoName" Style="{StaticResource Desc}" FontSize="13" Margin="0,2,0,0"/>
                            <TextBlock x:Name="Summary" Style="{StaticResource Desc}" Margin="0,12,0,14" MaxHeight="190" TextTrimming="WordEllipsis"/>
                            <ItemsControl x:Name="Genres" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource TextPill}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 게임 폴더·실행 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource Blue}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="게임" Style="{StaticResource Title}"/>
                        <TextBlock DockPanel.Dock="Top" Text="Steam 라이브러리에서 찾은 게임 폴더입니다." Style="{StaticResource Desc}" Margin="0,6,0,14"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource Primary}" Tag="{StaticResource IconPlay}" Content="게임 실행" ContentTemplate="{StaticResource IconText}"
                                    Click="Play_Click" IsEnabled="{Binding CanPlay}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Ghost}" Tag="{StaticResource IconFolder}" Content="폴더 열기" ContentTemplate="{StaticResource IconText}"
                                    Click="Folder_Click" IsEnabled="{Binding HasRoot}"/>
                        </StackPanel>
                        <StackPanel>
                            <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                                <TextBlock Text="{Binding RootText}" Style="{StaticResource Desc}" FontSize="12" Foreground="{StaticResource Ink}"/>
                            </Border>
                            <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock Text="출시" Style="{StaticResource Desc}" FontSize="13" Width="54"/>
                                    <TextBlock x:Name="Released" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock Text="개발" Style="{StaticResource Desc}" FontSize="13" Width="54"/>
                                    <TextBlock x:Name="Developers" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Inner}">
                                <DockPanel>
                                    <TextBlock Text="배급" Style="{StaticResource Desc}" FontSize="13" Width="54"/>
                                    <TextBlock x:Name="Publishers" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 모드(애드온) 설치·제거·버전 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource Purple}">
                    <StackPanel>
                        <TextBlock Text="모드" Style="{StaticResource Title}"/>
                        <TextBlock Text="설치하면 게임 폴더에 모드 파일을 복사하고, 제거하면 덮어쓴 파일까지 원래대로 되돌립니다. 버전이 여러 개면 골라서 설치할 수 있습니다."
                                   Style="{StaticResource Desc}" Margin="0,6,0,16"/>
                        <ItemsControl ItemsSource="{Binding Addons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inner}" Padding="18,16" Margin="0,0,0,12">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Ghost}" Content="설정" Click="ModConfig_Click" Margin="0,0,8,0"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}"/>
                                                <Button Style="{StaticResource Ghost}" Content="제거" Click="Uninstall_Click" Margin="0,0,8,0"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}"/>
                                                <Button Style="{StaticResource Primary}" Content="{Binding InstallLabel}" Click="Install_Click"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                                    <Border CornerRadius="999" Padding="9,3" Margin="10,0,0,0" Background="#EEEAFD" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#4A3E8C"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Desc}" FontSize="12" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Desc}" FontSize="13" Margin="0,4,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                            Visibility="{Binding HasManyVersions, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="버전" Style="{StaticResource Desc}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" MinWidth="180"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Compat}" FontSize="12" FontWeight="SemiBold" Foreground="#A1452A" TextWrapping="Wrap"
                                                           Margin="0,6,0,0" Visibility="{Binding HasCompat, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 감지한 모드 로더 -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource Green}">
                    <StackPanel>
                        <TextBlock Text="모드 로더" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="LoaderHint" Style="{StaticResource Desc}" Margin="0,6,0,16"/>
                        <ListBox x:Name="LoaderList" ItemsSource="{Binding Loaders}" ItemContainerStyle="{StaticResource PillItem}"
                                 ItemsPanel="{StaticResource Wrap}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <WrapPanel x:Name="LoaderButtons" Margin="0,6,0,0">
                            <Button Style="{StaticResource Ghost}" Content="로더 설정" Click="LoaderConfig_Click" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource Ghost}" Content="선택한 로더 제거" Click="RemoveLoader_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding InstallableLoaders}" ItemsPanel="{StaticResource Wrap}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Primary}" Content="{Binding Label}" Click="InstallLoader_Click" Margin="0,0,8,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 런처 설정 -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Grid Margin="0,4,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 업데이트 -->
                <Border Style="{StaticResource Card}" Background="{StaticResource Blue}">
                    <StackPanel>
                        <TextBlock Text="업데이트" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Desc}" Margin="0,6,0,16"/>
                        <Border Style="{StaticResource Inner}" Margin="0,0,0,12">
                            <DockPanel>
                                <CheckBox x:Name="AutoUpdateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                          Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="업데이트 자동 확인" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Text="시작할 때 새 LXIUM과 애드온 모음의 새 버전을 확인합니다." Style="{StaticResource Desc}" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Button Style="{StaticResource Primary}" Tag="{StaticResource IconRefresh}" Content="지금 업데이트 확인"
                                ContentTemplate="{StaticResource IconText}" Click="CheckNow_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Desc}" FontSize="13" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 정보 -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource Pink}">
                    <StackPanel>
                        <TextBlock Text="정보" Style="{StaticResource Title}"/>
                        <TextBlock Style="{StaticResource Desc}" Margin="0,6,0,16"
                                   Text="BepInEx·MelonLoader 모드를 게임에 설치·제거하고, 모드 설정을 바꾸고, 애드온 모음에서 받아 업데이트합니다."/>
                        <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                            <TextBlock FontSize="13" Foreground="{StaticResource Ink}" TextWrapping="Wrap">
                                <Run Text="2026 ⓒ iyu.e — "/><Hyperlink NavigateUri="https://iyu-e.tistory.com/" RequestNavigate="Link_Navigate"
                                    Foreground="{StaticResource Teal}">https://iyu-e.tistory.com/</Hyperlink>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Inner}">
                            <TextBlock Style="{StaticResource Desc}" FontSize="12">
                                <Run Text="아이콘: "/><Hyperlink NavigateUri="https://lucide.dev/" RequestNavigate="Link_Navigate"
                                    Foreground="{StaticResource Teal}">Lucide</Hyperlink><Run Text=" (ISC 라이선스, Lucide-LICENSE.txt)"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 애드온 모음 -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Background="{StaticResource Purple}">
                    <StackPanel>
                        <TextBlock Text="애드온 모음" Style="{StaticResource Title}"/>
                        <TextBlock Style="{StaticResource Desc}" Margin="0,6,0,16"
                                   Text="애드온 모음(catalog.json) 주소를 넣으면 그 모음의 애드온을 받고 업데이트할 수 있습니다. 애드온은 게임 안에서 실행되므로 믿을 수 있는 모음만 추가하세요."/>
                        <ItemsControl x:Name="CatalogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Inner}" Margin="0,0,0,10" Padding="16,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                    Tag="{StaticResource IconTrash}" ToolTip="모음 빼기" Click="RemoveCatalog_Click"/>
                                            <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="{StaticResource IconPlus}" Content="추가"
                                    ContentTemplate="{StaticResource IconText}" Click="AddCatalog_Click" Margin="10,0,0,0"/>
                            <TextBox x:Name="CatalogInput" Padding="10,8" FontSize="13" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="CatalogStatus" Style="{StaticResource Desc}" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
