<Window x:Class="LXIUM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:LXIUM.Views"
        xmlns:p="clr-namespace:LXIUM.Views.Pages"
        Title="LXIUM" Width="1180" Height="800" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Font}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid Margin="32,26,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- 머리글: 왼쪽 앱 이름 + 지금 화면, 오른쪽 도구 -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Style="{StaticResource Primary}" Tag="{StaticResource IconDownload}"
                            ContentTemplate="{StaticResource IconText}" Click="ApplyUpdate_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="BackButton" Style="{StaticResource Ghost}" Tag="{StaticResource IconBack}" Content="{l:T nav.library}"
                            ContentTemplate="{StaticResource IconText}" Click="Back_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconRefresh}"
                            ToolTip="{l:T nav.refresh}" Click="Refresh_Click" Margin="0,0,10,0"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconSettings}"
                            ToolTip="{l:T nav.settings}" Click="Settings_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="LXIUM" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="Subtitle" Style="{StaticResource Desc}"/>
                </StackPanel>
            </DockPanel>

            <Grid x:Name="Pages" Grid.Row="1" Margin="0,22,0,0">
                <p:LibraryPage x:Name="Library"/>
                <p:GamePage x:Name="GameView" Visibility="Collapsed"/>
                <p:ModsPage x:Name="Mods" Visibility="Collapsed"/>
                <p:SettingsPage x:Name="Settings" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- 오래 걸리는 작업 중: 화면을 덮고 진행 상황 -->
        <l:BusyOverlay x:Name="Busy" Visibility="Collapsed"/>

        <!-- 처음 실행: 언어 고르기 -->
        <p:LanguagePage x:Name="LanguageView" Visibility="Collapsed"/>
    </Grid>
</Window>
