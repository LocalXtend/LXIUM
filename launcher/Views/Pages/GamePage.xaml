<UserControl x:Class="LXIUM.Views.Pages.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LXIUM.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>
    <!-- 게임 설정 패널 (카드의 "설정" 칸): 게임 정보·폴더·로더. 모드는 모드 패널로 옮겨 갔고 바로 가는 카드를 둠 -->
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,4,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 로더 충돌 경고 -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource Inner}" Margin="0,0,0,20" Background="#FFF4EE"
                    Visibility="{Binding HasLoaderConflict, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Canvas Width="24" Height="24"><Path Data="{StaticResource IconAlert}" Stroke="#A1452A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding LoaderConflict}" FontSize="13" FontWeight="SemiBold" Foreground="#A1452A" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- 게임 정보 (Steam 상점) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource Pink}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Width="156" Height="208" CornerRadius="16" Background="White" Effect="{StaticResource Shadow}" VerticalAlignment="Top">
                        <Image x:Name="Cover" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,156,208" RadiusX="16" RadiusY="16"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,2,0,0">
                        <TextBlock Text="{Binding Game.Name}" Style="{StaticResource Title}" FontSize="26"/>
                        <TextBlock x:Name="InfoName" Style="{StaticResource Desc}" FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Summary" Style="{StaticResource Desc}" Margin="0,12,0,14" MaxHeight="190" TextTrimming="WordEllipsis"/>
                        <ItemsControl x:Name="Genres" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource TextPill}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 게임 폴더·실행 -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource Blue}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T game.title}" Style="{StaticResource Title}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{l:T game.desc}" Style="{StaticResource Desc}" Margin="0,6,0,14"/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Button Style="{StaticResource Primary}" Tag="{StaticResource IconPlay}" Content="{l:T game.play}" ContentTemplate="{StaticResource IconText}"
                                Click="Play_Click" IsEnabled="{Binding CanPlay}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource Ghost}" Tag="{StaticResource IconFolder}" Content="{l:T game.folder}" ContentTemplate="{StaticResource IconText}"
                                Click="Folder_Click" IsEnabled="{Binding HasRoot}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <StackPanel>
                        <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding RootText}" Style="{StaticResource Desc}" FontSize="12" Foreground="{StaticResource Ink}"/>
                        </Border>
                        <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="{l:T game.released}" Style="{StaticResource Desc}" FontSize="13" Width="64"/>
                                <TextBlock x:Name="Released" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="{l:T game.developer}" Style="{StaticResource Desc}" FontSize="13" Width="64"/>
                                <TextBlock x:Name="Developers" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Inner}">
                            <DockPanel>
                                <TextBlock Text="{l:T game.publisher}" Style="{StaticResource Desc}" FontSize="13" Width="64"/>
                                <TextBlock x:Name="Publishers" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 감지한 모드 로더 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Background="{StaticResource Green}">
                <StackPanel>
                    <TextBlock Text="{l:T loader.title}" Style="{StaticResource Title}"/>
                    <TextBlock x:Name="LoaderHint" Style="{StaticResource Desc}" Margin="0,6,0,16"/>
                    <ListBox x:Name="LoaderList" ItemsSource="{Binding Loaders}" ItemContainerStyle="{StaticResource PillItem}"
                             ItemsPanel="{StaticResource Wrap}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    <WrapPanel x:Name="LoaderButtons" Margin="0,6,0,0">
                        <Button Style="{StaticResource Ghost}" Tag="{StaticResource IconSliders}" Content="{l:T loader.config}" ContentTemplate="{StaticResource IconText}"
                                Click="LoaderConfig_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource Ghost}" Tag="{StaticResource IconRefresh}" Content="{l:T loader.update}" ContentTemplate="{StaticResource IconText}"
                                Click="LoaderUpdate_Click" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource Ghost}" Tag="{StaticResource IconTrash}" Content="{l:T loader.remove}" ContentTemplate="{StaticResource IconText}"
                                Click="RemoveLoader_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding InstallableLoaders}" ItemsPanel="{StaticResource Wrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Primary}" Tag="{StaticResource IconDownload}" Content="{Binding Label}" ContentTemplate="{StaticResource IconText}"
                                        Click="InstallLoader_Click" Margin="0,0,8,8"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 모드 패널로 -->
            <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Card}" Background="{StaticResource Purple}">
                <StackPanel>
                    <TextBlock Text="{l:T mods.title}" Style="{StaticResource Title}"/>
                    <TextBlock Text="{Binding ModSummary}" Style="{StaticResource Desc}" Margin="0,6,0,16"/>
                    <Button Style="{StaticResource Primary}" Tag="{StaticResource IconPackage}" Content="{l:T mods.open}" ContentTemplate="{StaticResource IconText}"
                            Click="OpenMods_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
