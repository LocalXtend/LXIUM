<UserControl x:Class="LXIUM.Views.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LXIUM.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4,0,24">
            <TextBlock x:Name="EmptyText" Style="{StaticResource Desc}" Visibility="Collapsed"/>
            <ItemsControl x:Name="GameList" AlternationCount="5" ItemsPanel="{StaticResource Wrap}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 게임 카드. 표지를 누르면 위에 설정·모드·플레이 세 칸이 뜨고, 카드 밖으로 나가거나 다른 곳을 누르면 사라짐 -->
                        <Border Width="236" Padding="14" Margin="0,0,20,20" Effect="{StaticResource Shadow}" MouseLeave="Card_MouseLeave">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Setter Property="Background" Value="{StaticResource Pink}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                            <Setter Property="Background" Value="{StaticResource Green}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="2">
                                            <Setter Property="Background" Value="{StaticResource Blue}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="3">
                                            <Setter Property="Background" Value="{StaticResource Purple}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="4">
                                            <Setter Property="Background" Value="{StaticResource Mint}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Width="208" Height="312" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Cover_Click">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,208,312" RadiusX="16" RadiusY="16"/>
                                    </Grid.Clip>
                                    <Rectangle Fill="#AAFFFFFF"/>
                                    <Image Source="{Binding CapsuleUrl}" Stretch="UniformToFill"/>
                                    <Grid x:Name="Overlay" Visibility="Collapsed" Opacity="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource ZoneLeft}" Tag="{StaticResource IconSettings}" Content="{l:T zone.settings}"
                                                Click="ZoneSettings_Click"/>
                                        <Button Grid.Column="1" Style="{StaticResource ZoneRight}" Tag="{StaticResource IconPackage}" Content="{l:T zone.mods}"
                                                Click="ZoneMods_Click"/>
                                        <Button Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ZonePlay}" Tag="{StaticResource IconPlay}" Content="{l:T zone.play}"
                                                Click="ZonePlay_Click"/>
                                        <!-- 칸 사이 흰 구분선 -->
                                        <Rectangle Grid.ColumnSpan="2" Height="1.5" VerticalAlignment="Bottom" Fill="White" IsHitTestVisible="False"/>
                                        <Rectangle Grid.Column="1" Width="1.5" HorizontalAlignment="Left" Fill="White" IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Title}" FontSize="17" Margin="4,14,4,8"/>
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="4,0,0,2">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource PillText}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
