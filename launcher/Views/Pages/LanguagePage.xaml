<UserControl x:Class="LXIUM.Views.Pages.LanguagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LXIUM.Views">
    <UserControl.Resources>
        <!-- 드롭다운 머리: 흰 바탕, 옅은 테두리, 오른쪽 아래 화살표 -->
        <Style x:Key="DropHeader" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="White" CornerRadius="12" BorderBrush="#E2DFEC" BorderThickness="1" Padding="18,13">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Teal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 드롭다운 항목: 마우스를 올리면 옅은 보라 -->
        <Style x:Key="DropItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="14,10" Margin="4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F0EEF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 처음 실행할 때 언어 고르기: 하얀 패널 가운데 드롭다운, 아래 "다음 →" -->
    <Grid Background="White">
        <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="LXIUM" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <Button Style="{StaticResource DropHeader}" Click="Toggle_Click">
                <DockPanel>
                    <Viewbox x:Name="Chevron" DockPanel.Dock="Right" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform><RotateTransform/></Viewbox.RenderTransform>
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronDown}" Stroke="{StaticResource Ink}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="Chosen" Text="Select language" FontSize="15" Foreground="{StaticResource Sub}"/>
                </DockPanel>
            </Button>

            <!-- 높이 0인 Canvas: 펼친 목록이 아래 버튼을 밀지 않고 위에 겹침 -->
            <Canvas Height="0" Panel.ZIndex="1">
                <Border x:Name="DropList" Width="340" Canvas.Top="6" Background="White" CornerRadius="12" BorderBrush="#E2DFEC" BorderThickness="1"
                        Padding="0,4" Effect="{StaticResource Shadow}" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform><ScaleTransform ScaleY="0.92"/></Border.RenderTransform>
                    <ItemsControl x:Name="Languages">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DropItem}" Click="Pick_Click">
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Ink}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Canvas>

            <Button x:Name="NextButton" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,28,0,0" Padding="26,11"
                    IsEnabled="False" Opacity="0.4" Click="Next_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:T lang.next}" FontSize="14" VerticalAlignment="Center"/>
                    <Viewbox Width="16" Height="16" Margin="8,0,0,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconArrowRight}" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
