<UserControl x:Class="LXIUM.Views.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LXIUM.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <!-- 모드 한 줄: 아이콘 | 이름·상태·버전·로더·태그·설명·호환 경고 | 버튼 -->
        <DataTemplate x:Key="ModRow">
            <Border Style="{StaticResource Inner}" Padding="18,16" Margin="0,0,6,12">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Border CornerRadius="14" Background="#F0EEF7"/>
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconPackage}" Stroke="{StaticResource Sub}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Image Source="{Binding Icon}" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,56,56" RadiusX="14" RadiusY="14"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" MaxWidth="330" HorizontalAlignment="Right" Margin="12,0,0,0">
                        <Button Style="{StaticResource Ghost}" Tag="{StaticResource IconSliders}" Content="{l:T mod.config}" ContentTemplate="{StaticResource IconText}"
                                Click="Config_Click" Margin="0,4,8,4" Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource Ghost}" Tag="{StaticResource IconTrash}" Content="{l:T mod.uninstall}" ContentTemplate="{StaticResource IconText}"
                                Click="Uninstall_Click" Margin="0,4,8,4" Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource Primary}" Tag="{StaticResource IconDownload}" Content="{Binding InstallLabel}" ContentTemplate="{StaticResource IconText}"
                                Click="Install_Click" Margin="0,4,0,4"/>
                    </WrapPanel>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,0,10,4"/>
                            <Border CornerRadius="999" Padding="9,3" Background="#EEEAFD" VerticalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#4A3E8C"/>
                            </Border>
                        </WrapPanel>
                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock Text="{Binding Version}" Style="{StaticResource Desc}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding LoaderNames}" ItemsPanel="{StaticResource Wrap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="999" Padding="8,2" Margin="0,2,6,2" Background="#E1F4D0">
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#3B5A24"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding TagNames}" ItemsPanel="{StaticResource Wrap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="999" Padding="8,2" Margin="0,2,6,2" Background="#F9DDEB">
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="#7A2E55"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Desc}" FontSize="13" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasManyVersions, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:T mod.version}" Style="{StaticResource Desc}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" MinWidth="200"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Compat}" FontSize="12" FontWeight="SemiBold" Foreground="#A1452A" TextWrapping="Wrap"
                                   Margin="0,6,0,0" Visibility="{Binding HasCompat, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 모드 패널 (카드의 "모드" 칸): 이 게임의 모드 검색·거르기, 추가·설치·업데이트·제거 -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Ghost}" Tag="{StaticResource IconSettings}" Content="{l:T zone.settings}" ContentTemplate="{StaticResource IconText}"
                        Click="GameSettings_Click"/>
            </StackPanel>
            <StackPanel>
                <!-- 검색 -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E2DFEC" BorderThickness="1" Padding="12,0" MaxWidth="460" HorizontalAlignment="Left" MinWidth="320">
                    <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource Sub}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Grid>
                            <TextBlock x:Name="SearchHint" Text="{l:T mods.search}" Style="{StaticResource Desc}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" FontSize="13" Padding="0,9" TextChanged="Filter_Changed"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <!-- 태그 거르기 -->
                <ItemsControl x:Name="TagFilter" ItemsPanel="{StaticResource Wrap}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Chip}" Content="{Binding Name}" Tag="{Binding Id}" IsChecked="{Binding Checked, Mode=OneTime}" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,28">
                <!-- 로더 충돌 경고 -->
                <Border x:Name="ConflictBox" Style="{StaticResource Inner}" Margin="0,0,6,16" Background="#FFF4EE" Visibility="Collapsed">
                    <DockPanel>
                        <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24"><Path Data="{StaticResource IconAlert}" Stroke="#A1452A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                        </Viewbox>
                        <TextBlock x:Name="ConflictText" FontSize="13" FontWeight="SemiBold" Foreground="#A1452A" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Background="{StaticResource Purple}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{l:T mods.added}" Style="{StaticResource Title}"/>
                        <TextBlock Text="{l:T mods.addedDesc}" Style="{StaticResource Desc}" Margin="0,6,0,16"/>
                        <TextBlock x:Name="AddedEmpty" Text="{l:T mods.addedEmpty}" Style="{StaticResource Desc}" FontSize="13" Visibility="Collapsed"/>
                        <ItemsControl x:Name="AddedList" ItemTemplate="{StaticResource ModRow}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Background="{StaticResource Blue}">
                    <StackPanel>
                        <TextBlock Text="{l:T mods.available}" Style="{StaticResource Title}"/>
                        <TextBlock Text="{l:T mods.availableDesc}" Style="{StaticResource Desc}" Margin="0,6,0,16"/>
                        <TextBlock x:Name="AvailableEmpty" Text="{l:T mods.availableEmpty}" Style="{StaticResource Desc}" FontSize="13" Visibility="Collapsed"/>
                        <ItemsControl x:Name="AvailableList" ItemTemplate="{StaticResource ModRow}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
