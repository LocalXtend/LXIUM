<UserControl x:Class="LXIUM.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LXIUM.Views">
    <!-- 런처 설정 (머리글 톱니) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,4,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 업데이트 -->
            <Border Style="{StaticResource Card}" Background="{StaticResource Blue}">
                <StackPanel>
                    <TextBlock Text="{l:T settings.update}" Style="{StaticResource Title}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Desc}" Margin="0,6,0,16"/>
                    <Border Style="{StaticResource Inner}" Margin="0,0,0,12">
                        <DockPanel>
                            <CheckBox x:Name="AutoUpdateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{l:T settings.autoUpdate}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                <TextBlock Text="{l:T settings.autoUpdateDesc}" Style="{StaticResource Desc}" FontSize="13" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Button Style="{StaticResource Primary}" Tag="{StaticResource IconRefresh}" Content="{l:T settings.checkNow}"
                            ContentTemplate="{StaticResource IconText}" Click="CheckNow_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Desc}" FontSize="13" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- 언어·정보 -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Background="{StaticResource Green}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.language}" Style="{StaticResource Title}"/>
                        <TextBlock Text="{l:T settings.languageDesc}" Style="{StaticResource Desc}" Margin="0,6,0,12"/>
                        <ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" SelectionChanged="Language_Changed" Padding="8,6"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Background="{StaticResource Pink}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.about}" Style="{StaticResource Title}"/>
                        <TextBlock Style="{StaticResource Desc}" Margin="0,6,0,16" Text="{l:T settings.aboutDesc}"/>
                        <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                            <TextBlock FontSize="13" Foreground="{StaticResource Ink}" TextWrapping="Wrap">
                                <Run Text="2026 ⓒ iyu.e — "/><Hyperlink NavigateUri="https://iyu-e.tistory.com/" RequestNavigate="Link_Navigate"
                                    Foreground="{StaticResource Teal}">https://iyu-e.tistory.com/</Hyperlink>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Inner}">
                            <TextBlock Style="{StaticResource Desc}" FontSize="12">
                                <Run Text="{l:T settings.icons}"/><Run Text=" "/><Hyperlink NavigateUri="https://lucide.dev/" RequestNavigate="Link_Navigate"
                                    Foreground="{StaticResource Teal}">Lucide</Hyperlink><Run Text=" (ISC, Lucide-LICENSE.txt)"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 애드온 모음 -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Background="{StaticResource Purple}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Tag="{StaticResource IconRefresh}" Content="{l:T settings.catalogReset}"
                                ContentTemplate="{StaticResource IconText}" Click="ResetCatalogs_Click" VerticalAlignment="Top"/>
                        <TextBlock Text="{l:T settings.catalogs}" Style="{StaticResource Title}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Desc}" Margin="0,6,0,16" Text="{l:T settings.catalogsDesc}"/>
                    <ItemsControl x:Name="CatalogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inner}" Margin="0,0,0,10" Padding="16,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                Tag="{StaticResource IconTrash}" ToolTip="{l:T settings.catalogRemove}" Click="RemoveCatalog_Click"/>
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Tag="{StaticResource IconPlus}" Content="{l:T settings.catalogAdd}"
                                ContentTemplate="{StaticResource IconText}" Click="AddCatalog_Click" Margin="10,0,0,0"/>
                        <TextBox x:Name="CatalogInput" Padding="10,8" FontSize="13" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="CatalogStatus" Style="{StaticResource Desc}" FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
