<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LXIUM_sephiria</AssemblyName>
    <RootNamespace>LXIUM_sephiria</RootNamespace>
    <Product>LXIUM Sephiria</Product>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)ver.txt').Trim())</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 게임의 Mono 기본 라이브러리(mscorlib·netstandard)로만 컴파일해 NuGet 없이 빌드 -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <!-- 게임 루트. 다른 위치면 빌드 때 -p:GameDir=... 로 지정 -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sephiria</GameDir>
    <ManagedDir>$(GameDir)\Sephiria_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <!-- 게임 어셈블리는 컴파일에만 씀 (배포하지 않음) -->
  <ItemGroup>
    <Reference Include="$(ManagedDir)\mscorlib.dll" Private="false" />
    <Reference Include="$(ManagedDir)\netstandard.dll" Private="false" />
    <Reference Include="$(ManagedDir)\System.dll" Private="false" />
    <Reference Include="$(ManagedDir)\System.Core.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.TilemapModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.GridModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Unity.RenderPipelines.Universal.2D.Runtime.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Newtonsoft.Json.dll" Private="false" />
    <!-- MelonLoader는 런처가 설치하므로 컴파일에만 씀 (docs/ai/addon.md 5장). 게임 폴더에 설치돼 있어야 빌드됨 -->
    <Reference Include="$(GameDir)\MelonLoader\net35\MelonLoader.dll" Private="false" />
  </ItemGroup>

  <!-- MelonLoader 모드 정보. 버전을 ver.txt에서 가져오려고 코드 대신 여기서 만듦 -->
  <ItemGroup>
    <AssemblyAttribute Include="MelonLoader.MelonInfoAttribute">
      <_Parameter1>typeof(LXIUM_sephiria.MelonEntry)</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>LXIUM Sephiria</_Parameter2>
      <_Parameter3>$(Version)</_Parameter3>
      <_Parameter4>LocalXtend</_Parameter4>
    </AssemblyAttribute>
    <AssemblyAttribute Include="MelonLoader.MelonGameAttribute">
      <_Parameter1>TEAMHORAY</_Parameter1>
      <_Parameter2>Sephiria</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- shaders/build_shaders.py로 만든 셰이더 번들. DLL에 넣어 파일 하나로 배포 -->
  <ItemGroup>
    <EmbeddedResource Include="res\lxium_sephiria.bundle" LogicalName="lxium_sephiria.bundle" />
  </ItemGroup>

  <!-- docs/ai/addon.md 7장: lxium.json의 version은 ver.txt와 같아야 함. 게임 로더가 읽는 metadata.json도 같이 확인 -->
  <Target Name="CheckManifestVersion" BeforeTargets="Build">
    <PropertyGroup>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)lxium.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ManifestVersion>
      <MetadataVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)metadata.json')), '"modVersion"\s*:\s*"([^"]+)"').Groups[1].Value)</MetadataVersion>
    </PropertyGroup>
    <Error Condition="'$(ManifestVersion)' != '$(Version)'" Text="lxium.json version '$(ManifestVersion)' != ver.txt '$(Version)'" />
    <Error Condition="'$(MetadataVersion)' != '$(Version)'" Text="metadata.json modVersion '$(MetadataVersion)' != ver.txt '$(Version)'" />
  </Target>

  <!-- Release 빌드: dist/<id>-<version>.zip. 변형 none = 게임 내장 AddOns 로더 (docs/ai/addon.md 2·4장) -->
  <Target Name="PackageAddon" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PkgDir>$(BaseIntermediateOutputPath)pkg\</PkgDir>
      <DistDir>$(MSBuildThisFileDirectory)dist\</DistDir>
      <ModDir>$(PkgDir)none\AddOns\$(AssemblyName)\</ModDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PkgDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)lxium.json" DestinationFolder="$(PkgDir)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll;$(MSBuildThisFileDirectory)metadata.json" DestinationFolder="$(ModDir)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(PkgDir)melonloader\Mods" />
    <MakeDir Directories="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(PkgDir)" DestinationFile="$(DistDir)$(AssemblyName)-$(Version).zip" Overwrite="true" />
  </Target>

  <!-- 개발용: -p:Deploy=true 이면 게임에 바로 복사. 런처처럼 MelonLoader가 있으면 Mods/, 없으면 AddOns/LXIUM_sephiria/ -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy Condition="Exists('$(GameDir)\MelonLoader\net35\MelonLoader.dll')" SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(GameDir)\Mods" />
    <Copy Condition="!Exists('$(GameDir)\MelonLoader\net35\MelonLoader.dll')" SourceFiles="$(OutDir)$(AssemblyName).dll;$(MSBuildThisFileDirectory)metadata.json" DestinationFolder="$(GameDir)\AddOns\$(AssemblyName)" />
  </Target>

</Project>
