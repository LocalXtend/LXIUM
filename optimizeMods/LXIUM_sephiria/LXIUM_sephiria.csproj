<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LXIUM_sephiria</AssemblyName>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)ver.txt').Trim())</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sephiria</GameDir>
    <ManagedDir>$(GameDir)\Sephiria_Data\Managed</ManagedDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="$(ManagedDir)\Unity*.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(ManagedDir)\Newtonsoft.Json.dll" Private="false" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <EmbeddedResource Include="res\lxium_sephiria.bundle" LogicalName="lxium_sephiria.bundle" />
    <EmbeddedResource Include="res\depth-safe-shaders.json" LogicalName="depth-safe-shaders.json" />
  </ItemGroup>
  <Target Name="CheckPackage" BeforeTargets="Build">
    <PropertyGroup>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)lxium.json')), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</ManifestVersion>
    </PropertyGroup>
    <Error Condition="'$(ManifestVersion)' != '$(Version)'" Text="lxium.json version must match ver.txt" />
    <Error Condition="!Exists('res\lxium_sephiria.bundle')" Text="Build the dedicated shader with shaders/build_world.py first." />
  </Target>
  <Target Name="PackageAddon" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PkgDir>$(MSBuildThisFileDirectory)obj\pkg\</PkgDir>
      <ModDir>$(PkgDir)none\AddOns\LXIUM_sephiria\</ModDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PkgDir)" />
    <Copy SourceFiles="lxium.json" DestinationFolder="$(PkgDir)" />
    <Copy SourceFiles="metadata.json;$(TargetPath)" DestinationFolder="$(ModDir)" />
    <Copy SourceFiles="$(PkgLib_Harmony)\lib\net472\0Harmony.dll" DestinationFolder="$(ModDir)Libs\" />
    <Copy SourceFiles="$(PkgLib_Harmony)\LICENSE" DestinationFiles="$(ModDir)Libs\Harmony.LICENSE" />
    <MakeDir Directories="dist" />
    <ZipDirectory SourceDirectory="$(PkgDir)" DestinationFile="$(MSBuildThisFileDirectory)dist\$(AssemblyName)-$(Version).zip" Overwrite="true" />
  </Target>
  <Target Name="DeployToGame" AfterTargets="PackageAddon" Condition="'$(Deploy)' == 'true' and '$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(ModDir)metadata.json;$(ModDir)LXIUM_sephiria.dll" DestinationFolder="$(GameDir)\AddOns\LXIUM_sephiria\" />
    <Copy SourceFiles="$(ModDir)Libs\0Harmony.dll" DestinationFolder="$(GameDir)\AddOns\LXIUM_sephiria\Libs\" />
    <Copy SourceFiles="$(ModDir)Libs\Harmony.LICENSE" DestinationFolder="$(GameDir)\AddOns\LXIUM_sephiria\Libs\" />
  </Target>
</Project>
