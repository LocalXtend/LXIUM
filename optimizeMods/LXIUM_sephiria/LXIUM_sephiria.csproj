<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LXIUM_sephiria</AssemblyName>
    <RootNamespace>LXIUM_sephiria</RootNamespace>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)ver.txt').Trim())</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 게임 루트. 다른 위치면 빌드 때 -p:SephiriaDir=... 로 지정 -->
    <SephiriaDir Condition="'$(SephiriaDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sephiria</SephiriaDir>
    <ManagedDir>$(SephiriaDir)\Sephiria_Data\Managed</ManagedDir>
  </PropertyGroup>

  <!-- 게임이 런타임에 제공하는 어셈블리. 출력에 복사하지 않음 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(ManagedDir)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime" HintPath="$(ManagedDir)\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" HintPath="$(ManagedDir)\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Universal.2D.Runtime" HintPath="$(ManagedDir)\Unity.RenderPipelines.Universal.2D.Runtime.dll" Private="false" />
  </ItemGroup>

  <!-- docs/ai/addon.md 7장: lxium.json의 version은 ver.txt와 같아야 함 -->
  <Target Name="CheckManifestVersion" BeforeTargets="Build">
    <PropertyGroup>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)lxium.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ManifestVersion>
    </PropertyGroup>
    <Error Condition="'$(ManifestVersion)' != '$(Version)'" Text="lxium.json version '$(ManifestVersion)' != ver.txt '$(Version)'" />
  </Target>

  <!-- 게임 AddOnLoader가 읽는 metadata.json. 공식 필드 5개만 씀 (docs/ai/sephiria.md 3장) -->
  <Target Name="WriteAddOnMetadata" AfterTargets="Build">
    <PropertyGroup>
      <AddOnMetadata>{
  "modName": "LXIUM Sephiria",
  "modVersion": "$(Version)",
  "modAuthor": "LocalXtend",
  "dllFile": "LXIUM_sephiria.dll",
  "entryClass": "LXIUM_sephiria.Entry"
}</AddOnMetadata>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)metadata.json" Lines="$(AddOnMetadata)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <!-- 개발용: -p:Deploy=true 이면 게임의 AddOns/LXIUM_sephiria/ 에 바로 복사 -->
  <Target Name="DeployToGame" AfterTargets="WriteAddOnMetadata" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(OutDir)LXIUM_sephiria.dll;$(OutDir)metadata.json" DestinationFolder="$(SephiriaDir)\AddOns\LXIUM_sephiria" />
  </Target>

</Project>
